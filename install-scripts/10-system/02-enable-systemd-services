#!/usr/bin/env bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

. "$SCRIPT_DIR/../lib/print"
. "$SCRIPT_DIR/../lib/prefs"

sudo systemctl daemon-reload

if ! systemctl is-enabled --quiet sddm.service; then
    sudo systemctl enable sddm.service
fi

if mt_is_desktop && ! systemctl is-enabled --quiet fileflows-node-watchdog.service; then
    sudo systemctl enable --now fileflows-node-watchdog.service
fi

systemctl --user daemon-reload

if ! systemctl --user is-enabled --quiet proton-pass-ssh-agent.service; then
    systemctl --user enable --now proton-pass-ssh-agent.service
fi

if ! systemctl --user is-enabled --quiet proton-pass-sync.timer; then
    systemctl --user enable --now proton-pass-sync.timer
fi

if ! systemctl --user is-enabled --quiet openrgb-server.service; then
    systemctl --user enable --now openrgb-server.service
fi

# Owns the Razer mouse; set-peripheral-settings drives it through razer-cli
if ! systemctl --user is-enabled --quiet openrazer-daemon.service; then
    systemctl --user enable --now openrazer-daemon.service
fi

print_step Done
