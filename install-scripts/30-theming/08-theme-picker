#!/usr/bin/env bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

. "$SCRIPT_DIR/../lib/print"

repo_dir="$HOME/projects/theme-picker"

if [[ ! -d "$repo_dir/.git" ]]; then
    print_step "Cloning theme-picker"
    git clone https://git.sr.ht/~rahmerh/theme-picker "$repo_dir"
fi

mkdir -p "$HOME/.local/bin"
ln -sfn "$repo_dir/bin/theme-picker" "$HOME/.local/bin/theme-picker"

print_step Done
