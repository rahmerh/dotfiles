#!/usr/bin/env bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

. "$SCRIPT_DIR/../lib/print"

repo_dir="$HOME/projects/the-sky"

if [[ ! -d "$repo_dir/.git" ]]; then
    print_step "Cloning the-sky"
    # Private repo: cloned over SSH (the proton-pass SSH agent is enabled in 10-system).
    if ! git clone git@git.sr.ht:~rahmerh/the-sky "$repo_dir"; then
        print_error "Could not clone the-sky; is the Proton Pass SSH agent unlocked?"
        exit 1
    fi
fi

mkdir -p "$HOME/.local/bin"
ln -sfn "$repo_dir/bin/theme-picker" "$HOME/.local/bin/theme-picker"

print_step Done
