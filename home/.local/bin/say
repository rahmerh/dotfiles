#!/usr/bin/env python3
"""Speak text in Bas's voice (~/.config/voice/voice.toml) via the shared Chatterbox server.

    say "The build is done."
    echo "Tests passed." | say
    say --out file.wav "..."   # write the audio instead of playing it

Starts the container and loads the model if needed; unloads it afterwards only if this run loaded it.
"""

import argparse
import json
import re
import subprocess
import sys
import tempfile
import time
import tomllib
import urllib.request
from pathlib import Path

PROFILE = Path.home() / ".config/voice/voice.toml"


def model_loaded(url: str) -> bool:
    with urllib.request.urlopen(f"{url}/api/model-info", timeout=5) as response:
        return bool(json.load(response).get("loaded"))


def post(url: str, path: str, body: dict | None = None, timeout: float = 30) -> bytes:
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(f"{url}{path}", data=data, method="POST", headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read()


def ensure_loaded(profile: dict, timeout: float = 300) -> bool:
    """Return True if this call had to load the model."""
    url = profile["tts_url"]
    deadline = time.monotonic() + timeout
    started = reloading = False
    while time.monotonic() < deadline:
        try:
            if model_loaded(url):
                return reloading or started
            if not reloading:
                reloading = True
                post(url, "/restart_server", timeout=max(deadline - time.monotonic(), 1))
                continue
        except OSError:
            if not started:
                subprocess.run(["docker", "start", profile["tts_container"]], capture_output=True, timeout=60)
                started = True
        time.sleep(3)
    sys.exit(f"say: Chatterbox at {url} not ready after {timeout:.0f}s")


def main() -> None:
    parser = argparse.ArgumentParser(description="Speak text in Bas's voice.")
    parser.add_argument("text", nargs="*", help="text to speak; read from stdin if omitted")
    parser.add_argument("--out", type=Path, help="write the wav here instead of playing it")
    args = parser.parse_args()

    text = " ".join(args.text) or sys.stdin.read()
    text = text.strip()
    if not text:
        sys.exit("say: nothing to say")

    profile = tomllib.loads(PROFILE.read_text())
    for word, spoken in profile.get("pronunciations", {}).items():
        text = re.sub(rf"\b{re.escape(word)}\b", spoken, text)

    loaded_here = ensure_loaded(profile)
    try:
        audio = post(
            profile["tts_url"],
            "/tts",
            {
                "text": text,
                "voice_mode": "predefined",
                "predefined_voice_id": profile["voice"],
                "output_format": "wav",
                "split_text": True,
                "chunk_size": 200,
                **profile.get("settings", {}),
            },
            timeout=180,
        )
    finally:
        if loaded_here:
            try:
                post(profile["tts_url"], "/api/unload")
            except OSError:
                pass

    with tempfile.TemporaryDirectory() as tmp:
        raw = Path(tmp) / "raw.wav"
        raw.write_bytes(audio)
        out = args.out or Path(tmp) / "say.wav"
        subprocess.run(
            ["ffmpeg", "-loglevel", "error", "-y", "-i", str(raw),
             "-af", f"loudnorm=I={profile.get('loudness', -16.0)}:TP=-1.5:LRA=11", "-ar", "48000", str(out)],
            check=True,
            timeout=60,
        )
        if not args.out:
            subprocess.run(["pw-play", str(out)], check=True, timeout=300)


if __name__ == "__main__":
    main()
