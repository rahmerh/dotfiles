#!/usr/bin/env bash

set -euo pipefail

pass_cli="$HOME/.local/bin/pass-cli"
agent_sock="$HOME/.ssh/proton-pass-agent.sock"
initial_notify_after=60
notify_interval=900
refresh_interval=30
agent_pid=""
last_notify=0
started_at=$(date +%s)

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

log() {
    printf '%s\n' "$*"
}

cleanup() {
    if [[ -n $agent_pid ]] && kill -0 "$agent_pid" 2>/dev/null; then
        log "Stopping Proton Pass SSH agent child process $agent_pid"
        kill "$agent_pid" 2>/dev/null || true
        wait "$agent_pid" 2>/dev/null || true
    fi
}

shutdown() {
    exit 0
}

notify_waiting() {
    local now

    command -v notify-send >/dev/null 2>&1 || return 0

    now=$(date +%s)
    ((now - started_at >= initial_notify_after)) || return 0
    ((last_notify == 0 || now - last_notify >= notify_interval)) || return 0

    notify-send \
        "Proton Pass SSH agent not ready" \
        "Waiting for Proton Pass/keyring unlock; will keep retrying." \
        || true
    last_notify=$now
}

agent_is_running() {
    [[ -n $agent_pid ]] && kill -0 "$agent_pid" 2>/dev/null
}

agent_responds() {
    local status

    [[ -S $agent_sock ]] || return 1

    status=0
    SSH_AUTH_SOCK="$agent_sock" ssh-add -l >/dev/null 2>&1 || status=$?

    # ssh-add exits 1 when the agent is reachable but has no identities.
    [[ $status -eq 0 || $status -eq 1 ]]
}

start_agent() {
    if [[ -e $agent_sock ]]; then
        log "Removing stale agent socket: $agent_sock"
        rm -f "$agent_sock"
    fi

    log "Starting Proton Pass SSH agent"
    env PROTON_PASS_LINUX_KEYRING=dbus "$pass_cli" ssh-agent start \
        --socket-path "$agent_sock" \
        --refresh-interval "$refresh_interval" &
    agent_pid=$!
}

trap cleanup EXIT
trap shutdown INT TERM

start_agent

# Keys are loaded and refreshed by the agent itself; only wait until it serves
# the socket, retrying while Proton Pass or the keyring is still locked.
until agent_responds; do
    if ! agent_is_running; then
        wait "$agent_pid" 2>/dev/null || true
        log "Proton Pass SSH agent exited before becoming ready"
        notify_waiting
        sleep 10
        start_agent
        continue
    fi

    notify_waiting
    sleep 3
done

log "Proton Pass SSH agent is ready"
wait "$agent_pid"
