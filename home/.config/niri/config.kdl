input {
    keyboard {
        xkb {
            layout "us"
            options "caps:escape"
        }
    }

    focus-follows-mouse max-scroll-amount="0%"
}

hotkey-overlay {
    skip-at-startup
}

output "Dell Inc. DELL P2722HE 11CWDH3" {
    scale 1.0
    mode "1920x1080@60.00"
}

// Gaps, struts, the shadow's colours and offset, window corners and unfocused opacity come from
// theme-picker (the include at the end), since a theme can change them.
layout {
    focus-ring {
        on
        width 2
        // colours come from theme-picker, see the include at the end
    }

    default-column-width { proportion 0.5; }

   shadow {
        on
        softness 32
        spread 4
        draw-behind-window false
    }
}

blur {
    passes 2
    offset 0.5 
    noise 0.01
    saturation 1.0
}

animations {
    slowdown 1.05

    workspace-switch {
        spring damping-ratio=0.88 stiffness=1100 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.92 stiffness=900 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=0.92 stiffness=900 epsilon=0.0001
    }

    window-open {
        spring damping-ratio=0.72 stiffness=900 epsilon=0.0005

        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float slide = (1.0 - niri_progress) * min(size_geo.y * 0.18, 180.0);
                vec3 coords = vec3(coords_geo.x, coords_geo.y - slide / size_geo.y, 1.0);

                if (coords.x < 0.0 || coords.x > 1.0 || coords.y < 0.0 || coords.y > 1.0) {
                    return vec4(0.0);
                }

                vec3 coords_tex = niri_geo_to_tex * coords;
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * smoothstep(0.0, 0.82, niri_clamped_progress);
            }
        "
    }

    window-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0005

        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float slide = niri_progress * min(size_geo.y * 0.18, 180.0);
                vec3 coords = vec3(coords_geo.x, coords_geo.y - slide / size_geo.y, 1.0);

                if (coords.x < 0.0 || coords.x > 1.0 || coords.y < 0.0 || coords.y > 1.0) {
                    return vec4(0.0);
                }

                vec3 coords_tex = niri_geo_to_tex * coords;
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * (1.0 - smoothstep(0.0, 0.82, niri_clamped_progress));
            }
        "
    }
}

prefer-no-csd

environment {
    PROTON_PASS_LINUX_KEYRING "dbus"
}

// theme-picker's sky is the whole desktop around the windows: wallpaper, bar, notifications, tray and
// launcher. restore starts it, first, so the tray is there for the apps below.
spawn-sh-at-startup "~/.local/bin/theme-picker restore"
spawn-at-startup "steam" "-silent"
spawn-sh-at-startup "~/.config/niri/scripts/spawn-after-tray discord --start-minimized"
spawn-at-startup "blueman-applet"

spawn-sh-at-startup "~/.config/niri/scripts/set-peripheral-settings"
spawn-sh-at-startup "~/.local/bin/theme-picker ui"

binds {
    // The sky's launcher, in the applied theme's style.
    Mod+Space { spawn-sh "~/.local/bin/theme-picker launch"; }

    Mod+T { spawn "kitty"; }
    Mod+Shift+T { spawn-sh "~/.local/bin/theme-picker toggle"; }

    Ctrl+Shift+S { spawn-sh "~/.config/niri/scripts/screenshot copy"; }
    Ctrl+Shift+A { spawn-sh "~/.config/niri/scripts/screenshot save"; }
    Ctrl+Shift+D { spawn-sh "~/.config/niri/scripts/screenshot both"; }

    Mod+Shift+D repeat=false { spawn-sh "wl-mirror $(niri msg --json focused-output | jq -r .name)"; }

    // Screen sharing: niri-cast-portal starts every share on the active
    // window; these re-point the live stream without re-prompting.
    Mod+Alt+E { spawn-sh "~/.config/niri/scripts/cast monitor"; }
    Mod+Alt+R { spawn-sh "~/.config/niri/scripts/cast window"; }
    Mod+Alt+T { spawn-sh "~/.config/niri/scripts/cast hide"; }
    Mod+Alt+X { spawn-sh "~/.config/niri/scripts/cast stop"; }

    Ctrl+Shift+L { spawn "hyprlock"; }

    Mod+B repeat=false { spawn "rofi-rbw"; }
    Mod+P repeat=false {
        spawn-sh "rofi -show password-search -modi 'password-search:~/.config/rofi/scripts/password-search.sh' -sorting-method fzf";
    }

    // The sky's notification history.
    Mod+N { spawn-sh "~/.local/bin/theme-picker notifications"; }

    Mod+Q { close-window; }
    Mod+V { toggle-window-floating; }
    Mod+F { fullscreen-window; }

    Mod+H { focus-column-left; }
    Mod+J { focus-workspace-down; }
    Mod+K { focus-workspace-up; }
    Mod+L { focus-column-right; }

    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-to-workspace-down; }
    Mod+Shift+K     { move-window-to-workspace-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+Ctrl+H { set-column-width "-5%"; }
    Mod+Ctrl+L { set-column-width "+5%"; }

    Mod+Ctrl+F { maximize-column; }

    Mod+Ctrl+J { set-window-height "+5%"; }
    Mod+Ctrl+K { set-window-height "-5%"; }

    Mod+G { consume-window-into-column; }
    Mod+Shift+G { expel-window-from-column; }

    Mod+C { center-column; }
    Mod+D { spawn-sh "~/.config/niri/scripts/equalize-column-widths"; }
}

// theme-picker's sky launcher: blur what's behind it.
layer-rule {
    match namespace="^theme-picker-launcher$"
    background-effect { blur true; }
}

layer-rule {
    match namespace="^cast-confirm$"

    shadow {
        on
        softness 28
        spread 3
        offset x=0 y=8
        color "#00000099"
    }

    geometry-corner-radius 12
    background-effect { blur true; }
}

layer-rule {
    match namespace="^luca-widget$"

    shadow {
        on
        softness 28
        spread 3
        offset x=0 y=8
        color "#00000099"
    }

    geometry-corner-radius 10
    background-effect { blur true; }
}

window-rule {
    match app-id="feh"
    open-floating true
}

window-rule {
    match title="rbw"
    match app-id="Pinentry-gtk"
    open-floating true
}

window-rule {
    match app-id="com-azefsw-audioconnect-desktop-app-MainKt"
    open-floating true
}

window-rule {
    clip-to-geometry true
    draw-border-with-background false
}

// Theme colours, generated by theme-picker. Optional, so a fresh install without a theme yet still loads.
include optional=true "~/.local/state/theme-picker/current/niri.kdl"
