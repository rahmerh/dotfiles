configuration {
    modi: "drun,run,window";
    show-icons: true;
    drun-display-format: "{name}";

    display-drun: "";
    display-run: "";
    display-window: "";
    display-power: "";

    drun-display-format: "{name}";
    sidebar-mode: false;

    matching: "fuzzy";
    sort: true;
    case-sensitive: false;
}

/* Colours, and the theme's own layout, generated by theme-picker */
@import "~/.local/state/theme-picker/current/rofi.rasi"
