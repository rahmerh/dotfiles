#!/usr/bin/env bash
set -u -o pipefail

BACKUP_DIR="/var/lib/backup-system"
CONF_FILE="$BACKUP_DIR/config"
LOG_FILE="$BACKUP_DIR/log"
LAST_SUCCESS_FILE="$BACKUP_DIR/last-success"
STATUS_FILE="$BACKUP_DIR/status"
LOCK_FILE="$BACKUP_DIR/lock"
MAX_DELETE=5000
RSYNC_TIMEOUT=600

# Example /var/lib/backup-system/config:
# DESTINATION="backup-host:/srv/backups/system"
# BACKUP_DIRS="/home/user/"
# SSH_KEY_FILE="/root/.ssh/backup-system"
# Optional:
# EXCLUDES="/.cache:/.local/share/Trash"

DEFAULT_EXCLUDES=(
    "node_modules/"
    "target/"
    "__pycache__/"
    ".venv/"
    ".mypy_cache/"
    ".pytest_cache/"
    ".ruff_cache/"
    ".gradle/"
    ".npm/"
    ".cargo/registry/"
    ".cargo/git/"
    "go/pkg/mod/"
    "Cache/"
    "Code Cache/"
    "GPUCache/"
    "Service Worker/CacheStorage/"
    "DawnWebGPUCache/"
    "DawnGraphiteCache/"
)

install --directory --owner=root --group=root --mode=0755 "$BACKUP_DIR"

exec 9>"$LOCK_FILE"
if ! flock --nonblock 9; then
    printf '%s\n' "Another system backup is already running." >&2
    exit 0
fi

if [[ -f "$LOG_FILE" ]]; then
    mv --force "$LOG_FILE" "$LOG_FILE.1"
fi

: >"$LOG_FILE"
chmod 0644 "$LOG_FILE"

log() {
    printf '%s\n' "$*" | tee -a "$LOG_FILE"
}

write_status() {
    local temp
    temp="$(mktemp "$BACKUP_DIR/.status.XXXXXX")"
    printf '%s\t%s\t%s\n' "$(date --iso-8601=seconds)" "$1" "$2" >"$temp"
    chmod 0644 "$temp"
    mv --force --no-target-directory "$temp" "$STATUS_FILE"
}

fail() {
    log "$1"
    write_status error "$1"
    exit 1
}

trap 'fail "System backup interrupted."' INT TERM

today="$(date +%F)"
if [[ -r "$LAST_SUCCESS_FILE" ]] && [[ "$(cat "$LAST_SUCCESS_FILE")" == "$today" ]]; then
    exit 0
fi

[[ -f "$CONF_FILE" ]] || fail "Config file not found: $CONF_FILE"

# shellcheck disable=SC1090
source "$CONF_FILE"

for required in DESTINATION BACKUP_DIRS SSH_KEY_FILE; do
    [[ -n "${!required:-}" ]] || fail "Config value missing or empty: $required"
done

IFS=":" read -r -a sources <<<"$BACKUP_DIRS"

rsync_args=(
    -a
    --delete
    --max-delete="$MAX_DELETE"
    --timeout="$RSYNC_TIMEOUT"
    --info=stats2
    --no-group
    --no-owner
    -e "ssh -i $SSH_KEY_FILE -o IdentitiesOnly=yes"
)

for exclude in "${DEFAULT_EXCLUDES[@]}"; do
    rsync_args+=(--exclude="$exclude")
done

if [[ -n "${EXCLUDES:-}" ]]; then
    IFS=":" read -r -a excludes <<<"$EXCLUDES"
    for exclude in "${excludes[@]}"; do
        rsync_args+=(--exclude="$exclude")
    done
fi

log "Starting system backup to $DESTINATION"
log "Sources: ${sources[*]}"
log "Log: $LOG_FILE"
write_status running "System backup started."

rsync "${rsync_args[@]}" "${sources[@]}" "$DESTINATION" 2>&1 | tee -a "$LOG_FILE"
rsync_status="${PIPESTATUS[0]}"

case "$rsync_status" in
    0)
        ;;
    24)
        log "Warning: some files vanished during transfer (rsync exit code 24)."
        ;;
    23)
        log "Warning: some files could not be transferred (rsync exit code 23)."
        ;;
    *)
        fail "System backup failed (rsync exit code $rsync_status)."
        ;;
esac

printf '%s\n' "$today" >"$LAST_SUCCESS_FILE"
chmod 0644 "$LAST_SUCCESS_FILE"
log "System backup completed."
write_status completed "System backup completed."
